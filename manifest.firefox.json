{
  "manifest_version": 3,
  "name": "Amazon Subscribe & Save - Cancel All",
  "version": "1.1.0",
  "description": "Cancel all Amazon Subscribe & Save subscriptions with one click.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.amazon.ca/*",
    "https://www.amazon.co.uk/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "subscribe-save-cancel-all@buza.dev",
      "strict_min_version": "121.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Amazon Cancel All subscribe and save",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/auto-deliveries*",
        "https://www.amazon.com/gp/subscribe-and-save/*",
        "https://www.amazon.ca/auto-deliveries*",
        "https://www.amazon.ca/gp/subscribe-and-save/*",
        "https://www.amazon.co.uk/auto-deliveries*",
        "https://www.amazon.co.uk/gp/subscribe-and-save/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.co.uk/*"
      ],
      "js": ["reminder.js"],
      "run_at": "document_idle"
    }
  ]
}
